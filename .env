

# ─── Service URLs (used by the backend container in `app` profile) ────────
# Inside docker compose, hostnames are service names. For local dev outside
# docker, see backend/.env.example for `localhost` equivalents.
DATABASE_URL=postgresql+asyncpg://postgres:your-strong-password@db:5432/arxiv_db
REDIS_URL=redis://redis:6379/0
ELASTICSEARCH_URL=http://elasticsearch:9200

# Database
DB_PASSWORD=your-strong-password

# Backend
SECRET_KEY=your-random-secret-key-at-least-32-characters-long
BACKEND_PORT=1229
CORS_ORIGINS=http://localhost:3000,https://archive.madaniyhayot.uz

# Frontend
FRONTEND_PORT=1228
API_BASE_URL=https://archive.madaniyhayot.uz
