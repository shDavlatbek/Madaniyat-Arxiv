# Local-dev backend env. Copy to backend/.env and adjust as needed.
# Inside docker compose `app` profile, see root .env.example instead.

# ─── Database ──────────────────────────────────────────────────────────────
# Default points at the dockerized postgres on localhost. For SQLite legacy
# mode, swap to the commented line.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/arxiv_db
# DATABASE_URL=sqlite+aiosqlite:///./arxiv_db.db

# ─── Search / queue (dockerized infra on localhost) ───────────────────────
REDIS_URL=redis://localhost:6379/0
ELASTICSEARCH_URL=http://localhost:9200

# ─── Auth ─────────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── Storage ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
