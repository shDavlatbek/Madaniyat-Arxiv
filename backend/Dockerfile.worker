FROM python:3.13-slim

# OCR system deps. tesseract-ocr-* packs are pulled per language we expect
# in the corpus (Uzbek Latin + Cyrillic, Russian, English). poppler-utils
# is the runtime pdf2image needs to render PDF pages for the Tesseract
# fallback path; PyMuPDF handles the embedded-text fast path with no system
# dependency.
RUN apt-get update && apt-get install -y --no-install-recommends \
      tesseract-ocr \
      tesseract-ocr-uzb \
      tesseract-ocr-uzb-cyrl \
      tesseract-ocr-rus \
      tesseract-ocr-eng \
      poppler-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN pip install --no-cache-dir uv

COPY pyproject.toml uv.lock ./
RUN uv venv .venv && uv sync --frozen

COPY . .

CMD ["uv", "run", "arq", "src.infrastructure.jobs.worker.WorkerSettings"]
